# Copy this file to .env and replace every placeholder with an independent random value.
JWT_SECRET=change-this-to-a-random-32-char-string
GATEWAY_IDENTITY_SECRET=change-this-to-another-32-char-string
MEDIA_REFERENCE_SERVICE_TOKEN=change-this-to-a-third-32-char-string
MEDIA_SIGNING_SECRET=change-this-to-a-fourth-32-char-string
INTERNAL_SERVICE_TOKEN=change-this-to-a-fifth-32-char-string

# Default off. Enabled is synthetic-only until client and release gates are approved.
# Both services must use the same mode; true declares externally enforced paused writes.
COMPLETION_PROTOCOL_MODE=legacy
COMPLETION_WRITES_PAUSED=false
# resource only; independent protected volumes and readiness probes must be verified first.
COMPLETION_STORAGE_CONFIRMED=false

# Dedicated resource-to-homework credential, injected only into those two services.
# Generate independently (at least 32 random characters), e.g. openssl rand -hex 32.
# Never reuse media-reference, internal/star, Gateway, JWT or media-signing secrets.
# Empty is allowed in legacy mode; enabled runtime must reject a missing credential.
COMPLETION_RETIREMENT_SERVICE_TOKEN=
# Resource-only orphan cleanup opt-in; keep false for real environments.
# Synthetic validation requires explicit activation and all readiness gates; no scheduled cleanup.
COMPLETION_ORPHAN_CLEANUP_ENABLED=false
