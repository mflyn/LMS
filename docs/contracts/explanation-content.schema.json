{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lms.family.local/schemas/explanation-content-v1.json",
  "title": "ExplanationContent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "learningObjective",
    "targetCurriculumNodeIds",
    "prerequisites",
    "explanation",
    "correctionPrompt",
    "parentRubric",
    "citations"
  ],
  "properties": {
    "schemaVersion": { "const": "explanation-v1" },
    "learningObjective": { "type": "string", "minLength": 1, "maxLength": 500 },
    "targetCurriculumNodeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["curriculumNodeId", "name", "whyNeeded"],
        "properties": {
          "curriculumNodeId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "whyNeeded": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryMarkdown", "workedExampleMarkdown", "commonPitfalls"],
      "properties": {
        "summaryMarkdown": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "workedExampleMarkdown": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "commonPitfalls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "correctionPrompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "parentRubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["curriculumNodeId", "datasetVersion"],
        "properties": {
          "curriculumNodeId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "datasetVersion": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  }
}
