{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lms.family.local/schemas/tutor-stage-action-request-v1.json",
  "title": "TutorStageActionRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "action", "comment", "operationId", "expectedStateVersion"],
  "properties": {
    "schemaVersion": { "const": "tutor-stage-action-request-v1" },
    "action": { "type": "string", "enum": ["start-correction", "start-practice", "cancel"] },
    "comment": { "type": ["string", "null"], "maxLength": 2000 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "expectedStateVersion": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "enum": ["start-correction", "start-practice"] } },
        "required": ["action"]
      },
      "then": { "properties": { "comment": { "const": null } } }
    },
    {
      "if": {
        "properties": { "action": { "const": "cancel" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "comment": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    }
  ]
}
