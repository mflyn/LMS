{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lms.family.local/schemas/curriculum-ref-v1.json",
  "title": "CurriculumRef v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "datasetVersion",
    "nodeId",
    "nodeType",
    "mappingStatus",
    "mappingSource",
    "reviewedByParentId",
    "reviewedAt",
    "textbookScope",
    "evidenceSnapshot"
  ],
  "properties": {
    "schemaVersion": { "const": "curriculum-ref-v1" },
    "source": {
      "type": "string",
      "enum": ["k12-kgraph", "local-manual"]
    },
    "datasetVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "nodeType": { "type": "string", "minLength": 1, "maxLength": 80 },
    "displayName": { "type": ["string", "null"], "maxLength": 200 },
    "mappingStatus": {
      "type": "string",
      "enum": ["suggested", "confirmed", "rejected"]
    },
    "mappingSource": {
      "type": "string",
      "enum": ["k12_search", "parent_manual", "imported"]
    },
    "reviewedByParentId": { "type": ["string", "null"], "minLength": 1 },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "textbookScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "subject",
        "stage",
        "grade",
        "volume",
        "bookId",
        "chapterId",
        "sectionId"
      ],
      "properties": {
        "publisher": { "type": ["string", "null"], "maxLength": 120 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "stage": { "type": ["string", "null"], "maxLength": 80 },
        "grade": { "type": ["string", "null"], "maxLength": 80 },
        "volume": { "type": ["string", "null"], "maxLength": 80 },
        "bookId": { "type": ["string", "null"], "maxLength": 200 },
        "chapterId": { "type": ["string", "null"], "maxLength": 200 },
        "sectionId": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceHash", "capturedAt"],
      "properties": {
        "evidenceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "capturedAt": { "type": "string", "format": "date-time" },
        "sourceUri": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "mappingStatus": { "const": "suggested" },
        "reviewedByParentId": { "const": null },
        "reviewedAt": { "const": null }
      }
    },
    {
      "properties": {
        "mappingStatus": { "const": "confirmed" },
        "reviewedByParentId": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    {
      "properties": {
        "mappingStatus": { "const": "rejected" },
        "reviewedByParentId": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
