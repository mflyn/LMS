+        "operationId",
+        "artifactId",
+        "artifactVersion",
+        "artifactContentHash",
+        "expectedArtifactReviewVersion",
+        "expectedCycleStateVersion",
+        "revisedText",
+        "revisionReason"
+      ],
+      "properties": {
+        "schemaVersion": {
+          "const": "ai1-min-v1"
+        },
+        "operationId": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
+        },
+        "artifactId": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{24}$"
+        },
+        "artifactVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "artifactContentHash": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "expectedArtifactReviewVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "expectedCycleStateVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "revisedText": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 12000,
+          "pattern": "\\S"
+        },
+        "revisionReason": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 500,
+          "pattern": "\\S"
+        }
+      }
+    },
+    "review": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "schemaVersion",
+        "operationId",
+        "artifactId",
+        "artifactVersion",
+        "artifactContentHash",
+        "expectedArtifactReviewVersion",
+        "expectedCycleStateVersion",
+        "decision",
+        "comment",
+        "checks"
+      ],
+      "properties": {
+        "schemaVersion": {
+          "const": "ai1-min-v1"
+        },
+        "operationId": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
+        },
+        "artifactId": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{24}$"
+        },
+        "artifactVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "artifactContentHash": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "expectedArtifactReviewVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "expectedCycleStateVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "decision": {
+          "enum": [
+            "approve",
+            "reject"
+          ]
+        },
+        "comment": {
+          "type": "string",
+          "minLength": 0,
+          "maxLength": 500
+        },
+        "checks": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "mathCorrect",
+            "gradeAppropriate",
+            "chapterAppropriate",
+            "wordingReviewed"
+          ],
+          "properties": {
+            "mathCorrect": {
+              "type": "boolean"
+            },
+            "gradeAppropriate": {
+              "type": "boolean"
+            },
+            "chapterAppropriate": {
+              "type": "boolean"
+            },
+            "wordingReviewed": {
+              "type": "boolean"
+            }
+          }
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "decision": {
+                "const": "approve"
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "checks": {
+                "type": "object",
+                "properties": {
+                  "mathCorrect": {
+                    "const": true
+                  },
+                  "gradeAppropriate": {
+                    "const": true
+                  },
+                  "chapterAppropriate": {
+                    "const": true
+                  },
+                  "wordingReviewed": {
+                    "const": true
+                  }
+                }
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "decision": {
+                "const": "reject"
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "comment": {
+                "type": "string",
+                "minLength": 1,
+                "maxLength": 500,
+                "pattern": "\\S"
+              }
+            }
+          }
+        }
+      ]
+    },
+    "close": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "schemaVersion",
+        "operationId",
+        "expectedCycleStateVersion",
+        "reason"
+      ],
+      "properties": {
+        "schemaVersion": {
+          "const": "ai1-min-v1"
+        },
+        "operationId": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
+        },
+        "expectedCycleStateVersion": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 9007199254740991
+        },
+        "reason": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 500,
+          "pattern": "\\S"
+        }
+      }
+    }
+  },
+  "oneOf": [
+    {
+      "$ref": "#/$defs/create"
+    },
+    {
+      "$ref": "#/$defs/generate"
+    },
+    {
+      "$ref": "#/$defs/recover"
+    },
+    {
+      "$ref": "#/$defs/revise"
+    },
+    {
+      "$ref": "#/$defs/review"
+    },
+    {
+      "$ref": "#/$defs/close"
+    }
+  ]
+}
