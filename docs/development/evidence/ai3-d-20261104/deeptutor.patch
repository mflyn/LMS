+@pytest.mark.parametrize(
+    "fault,status",
+    [
+        ("success", "succeeded"),
+        ("missing-usage", "succeeded"),
+        ("invalid-content", "succeeded"),
+        ("provider-unknown", "unknown"),
+        ("not-sent", "failed_not_sent"),
