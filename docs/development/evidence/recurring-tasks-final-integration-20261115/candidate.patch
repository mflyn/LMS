+const conflict = () => error(409, 'RECURRING_PLAN_COMMAND_CONFLICT');
+const clone = value => JSON.parse(JSON.stringify(value));
+const key = value => ({ familyId: value.familyId, actorId: value.actorId, operationId: value.operationId });
