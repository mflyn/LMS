+    expected = {"model": "synthetic-model", "messages": body["messages"], "max_tokens": 4096,
+                "stream": False, "thinking": {"type": "disabled"}}
+    assert counted == [rfc8785.dumps(expected)]
+    assert asyncio.run(provider.send(prepared)) == ("6180", {"inputTokens": 100, "outputTokens": 50})
+    assert len(calls) == len(keys) == 1
+    assert calls[0].url == "https://api.deepseek.com/chat/completions"
