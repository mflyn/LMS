+  expect(screen.queryByText('反思已保存。')).not.toBeInTheDocument();
+  expect(screen.queryByDisplayValue('检查结果')).not.toBeInTheDocument();
+  expect(screen.getByRole('button', { name: '新增反思' })).toBeDisabled();
+  await waitFor(() => expect(api.listOwnGrowthLogs).toHaveBeenCalledTimes(2));
+});
+
+test('same-identity 403 remains denied after changing week', async () => {
+  const user = userEvent.setup(); const view = open(); await edit(user);
+  api.listOwnGrowthLogs.mockRejectedValueOnce({ response: { status: 403 } });
+  await user.click(screen.getByRole('button', { name: '重新加载反思' }));
+  await screen.findByText('当前身份无法读取此记录。');
+  api.listOwnGrowthLogs.mockResolvedValue(result([{ ...row, content: '不可重新显示' }]));
+  view.rerender(<ReflectionPanel {...props} weekStart="2026-11-02" />);
+  await act(async () => {});
+  expect(screen.getByText('当前身份无法读取此记录。')).toBeInTheDocument();
+  expect(screen.queryByText('不可重新显示')).not.toBeInTheDocument();
+  expect(api.listOwnGrowthLogs).toHaveBeenCalledTimes(2);
+});
+test('late 403 from another week of the same identity clears the current week', async () => {
+  const user = userEvent.setup(); const view = open(); await edit(user); let reject;
+  api.updateOwnGrowthLog.mockImplementation(() => new Promise((resolve, fail) => { reject = fail; }));
+  await user.click(screen.getByRole('button', { name: '保存反思' }));
+  api.listOwnGrowthLogs.mockResolvedValue(result([{ ...row, content: '新周内容' }]));
+  view.rerender(<ReflectionPanel {...props} weekStart="2026-11-02" />);
+  await screen.findByText('新周内容');
+  await act(async () => reject({ response: { status: 403 } }));
+  expect(screen.getByText('当前身份无法读取此记录。')).toBeInTheDocument();
+  expect(screen.queryByText('新周内容')).not.toBeInTheDocument();
+});
+test('late 403 from a replaced identity cannot deny the new authenticated session', async () => {
+  const user = userEvent.setup(); open(); await edit(user); let reject;
+  api.updateOwnGrowthLog.mockImplementation(() => new Promise((resolve, fail) => { reject = fail; }));
+  await user.click(screen.getByRole('button', { name: '保存反思' }));
+  act(() => login());
+  await screen.findByText(/保存结果尚未确定/);
+  await act(async () => reject({ response: { status: 403 } }));
+  expect(screen.queryByText('当前身份无法读取此记录。')).not.toBeInTheDocument();
+  expect(screen.getByText(/保存结果尚未确定/)).toBeInTheDocument();
+});
+test.each(['pending', 'failed', 'success'])('finishing all-week reconciliation never exposes historical rows as current-week edits (%s)', async state => {
+  const user = userEvent.setup(); open(); await edit(user);
+  api.updateOwnGrowthLog.mockRejectedValueOnce(new Error('lost'));
+  await user.click(screen.getByRole('button', { name: '保存反思' }));
+  await screen.findByText(/保存结果尚未确定/);
+  const old = { ...row, logId: id(9), date: '2026-10-19', content: '历史周记录' };
+  api.listOwnGrowthLogs.mockResolvedValueOnce(result([row, old]));
+  await user.click(screen.getByRole('button', { name: '重读全部记录并核对' }));
+  await screen.findByText('历史周记录');
+  let finish;
+  api.listOwnGrowthLogs.mockImplementationOnce(() => new Promise((resolve, reject) => {
+    finish = () => state === 'failed' ? reject(new Error('offline')) : resolve(result([row]));
+  }));
+  await user.click(screen.getByRole('button', { name: '已核对，结束上次编辑' }));
+  expect(screen.queryByText('历史周记录')).not.toBeInTheDocument();
+  expect(screen.queryByRole('button', { name: '修改反思：历史周记录' })).not.toBeInTheDocument();
+  expect(screen.getByRole('button', { name: '新增反思' })).toBeDisabled();
+  if (state !== 'pending') {
+    await act(async () => finish());
+    expect(screen.queryByText('历史周记录')).not.toBeInTheDocument();
+    if (state === 'success') expect(screen.getByRole('button', { name: '修改反思：合成练习' })).toBeEnabled();
+    else expect(screen.getByRole('button', { name: '新增反思' })).toBeDisabled();
+  }
+  expect(api.updateOwnGrowthLog).toHaveBeenCalledTimes(1);
+});
diff --git a/frontend/web/src/__tests__/shared/reflectionApi.test.js b/frontend/web/src/__tests__/shared/reflectionApi.test.js
new file mode 100644
index 00000000..63cdcb6f
--- /dev/null
+++ b/frontend/web/src/__tests__/shared/reflectionApi.test.js
@@ -0,0 +1,68 @@
+import axios from 'axios';
+import * as child from '../../services/childApi';
+import * as parent from '../../services/familyApi';
+import { captureSession, saveChildSession, saveParentSession } from '../../services/familySession';
+
+jest.mock('axios');
+const save = (role, token = 'a') => role === 'student'
+  ? saveChildSession({ token, child: { childId: token, familyId: 'f', name: '合成孩子' } })
+  : saveParentSession({ token, user: { id: token, role: 'parent' } });
+beforeEach(() => { jest.resetAllMocks(); localStorage.clear(); sessionStorage.clear(); });
+
+test('child reflection create binds the actor and drops parent, audit, duration and foreign-child fields', async () => {
+  save('student'); const session = captureSession('student'), signal = new AbortController().signal;
+  axios.post.mockResolvedValue({ data: { success: true, data: { log: { logId: 'saved' } } } });
+  const payload = { date: '2026-10-26', dimension: 'academic', subject: '数学', content: '练习', childReflection: '学会检查',
+    childId: 'other', familyId: 'other', parentNote: 'forged', createdBy: 'forged', durationMinutes: 99 };
+  await expect(child.createOwnGrowthLog(payload, signal, session)).resolves.toEqual({ log: { logId: 'saved' } });
+  expect(axios.post).toHaveBeenCalledWith('/api/growth-logs', {
+    childId: 'a', date: payload.date, dimension: payload.dimension, subject: payload.subject,
+    content: payload.content, childReflection: payload.childReflection
+  }, { signal, headers: { Authorization: 'Bearer a' } });
+});
+
+test('child list keeps pagination/date filters but never accepts another child or family', async () => {
+  save('student'); axios.get.mockResolvedValue({ data: { data: { items: [] } } });
+  await child.listOwnGrowthLogs({ from: '2026-10-26', to: '2026-11-01', page: 2, pageSize: 100,
+    childId: 'other', familyId: 'other' });
+  const [url, config] = axios.get.mock.calls[0];
+  const query = new URL(url, 'http://synthetic.test').searchParams;
+  expect(Object.fromEntries(query)).toEqual({ from: '2026-10-26', to: '2026-11-01', page: '2', pageSize: '100' });
+  expect(config.headers.Authorization).toBe('Bearer a');
+});
+
+test('child reflection PATCH preserves explicit empty and cannot overwrite other record fields', async () => {
+  save('student'); axios.patch.mockResolvedValue({ data: { data: { log: {} } } });
+  await child.updateOwnGrowthLog('log/id', { childReflection: '', content: 'old', parentNote: 'forged', durationMinutes: 0 });
+  expect(axios.patch).toHaveBeenCalledWith('/api/growth-logs/log%2Fid', { childReflection: '' },
+    { headers: { Authorization: 'Bearer a' } });
+});
+
+const invoke = (role, method, session) => role === 'student'
+  ? method === 'get' ? child.listOwnGrowthLogs({}, undefined, session)
+    : method === 'post' ? child.createOwnGrowthLog({}, undefined, session)
+      : child.updateOwnGrowthLog('log', { childReflection: 'note' }, undefined, session)
+  : method === 'get' ? parent.listGrowthLogs({ childId: 'a' }, undefined, session)
+    : method === 'post' ? parent.createGrowthLog({ childId: 'a' }, undefined, session)
+      : parent.updateGrowthLog('log', { childReflection: 'note' }, undefined, session);
+
+test.each(['parent', 'student'].flatMap(role => ['get', 'post', 'patch'].map(method => [role, method])))(
+  '%s %s rejects a captured old session before any request', async (role, method) => {
+    save(role); const old = captureSession(role); save(role, 'b');
+    await expect(invoke(role, method, old)).rejects.toMatchObject({ code: 'SESSION_CHANGED' });
+    expect(axios[method]).not.toHaveBeenCalled();
+  }
+);
+test.each(['parent', 'student'].flatMap(role => [200, 401, 403].map(status => [role, status])))(
+  '%s late write %s cannot return private data or expire replacement identity', async (role, status) => {
+    save(role); let finish;
+    axios.post.mockImplementation(() => new Promise((resolve, reject) => {
+      finish = () => status === 200 ? resolve({ data: { data: { log: { content: 'private' } } } })
+        : reject({ response: { status } });
+    }));
+    const request = invoke(role, 'post', captureSession(role));
+    save(role, 'b'); finish();
+    await expect(request).rejects.toMatchObject({ code: 'SESSION_CHANGED' });
+    expect(captureSession(role).actorId).toBe('b');
+  }
+);
diff --git a/frontend/web/src/__tests__/shared/reflectionState.test.js b/frontend/web/src/__tests__/shared/reflectionState.test.js
new file mode 100644
index 00000000..184377e4
--- /dev/null
+++ b/frontend/web/src/__tests__/shared/reflectionState.test.js
@@ -0,0 +1,65 @@
+import { reflectionWeek, readReflectionLogs, readReflectionWrite, beginReflectionWrite, clearReflectionWrite } from '../../services/reflection';
+import { saveChildSession, clearChildSession } from '../../services/familySession';
+
+const id = n => String(n).padStart(24, '0');
+const scope = { role: 'student', actorId: id(1), familyId: id(2), childId: id(1) };
+const row = n => ({ logId: id(n), familyId: id(2), childId: id(1), date: '2026-10-26', childReflection: '合成反思' });
+beforeEach(() => { localStorage.clear(); sessionStorage.clear(); });
+
+test.each([
+  ['2026-10-25', '2026-10-19', '2026-10-25'],
+  ['2026-10-26', '2026-10-26', '2026-11-01'],
+  ['2027-01-01', '2026-12-28', '2027-01-03']
+])('week %s uses calendar arithmetic, not browser timezone', (date, from, to) => {
+  expect(reflectionWeek(date)).toEqual({ from, to });
+});
+test.each(['', '2026-02-30', '2026-1-1', '2026-10-26\n'])('rejects invalid date %j', date => {
+  expect(() => reflectionWeek(date)).toThrow();
+});
+test('complete recovery read includes all pages and no implicit week/dimension filter', async () => {
+  const rows = Array.from({ length: 101 }, (_, i) => row(i + 10));
+  const load = jest.fn(({ page }) => Promise.resolve({ page, pageSize: 100, total: 101,
+    items: page === 1 ? rows.slice(0, 100) : rows.slice(100) }));
+  expect(await readReflectionLogs(load, scope)).toEqual(rows);
+  expect(load.mock.calls.map(([query]) => query)).toEqual([
+    { childId: id(1), page: 1, pageSize: 100 }, { childId: id(1), page: 2, pageSize: 100 }
+  ]);
+});
+test.each(['foreign', 'duplicate', 'missing', 'changedTotal'])('incomplete or unsafe %s list cannot be used to reconcile', async mode => {
+  const first = Array.from({ length: 100 }, (_, i) => row(i + 10));
+  const last = mode === 'foreign' ? { ...row(110), childId: id(99) } : mode === 'duplicate' ? first[0] : row(110);
+  const load = jest.fn(({ page }) => Promise.resolve({ page, pageSize: 100,
+    total: page === 2 && mode === 'changedTotal' ? 102 : 101,
+    items: page === 1 ? first : mode === 'missing' ? [] : [last] }));
+  await expect(readReflectionLogs(load, scope)).rejects.toThrow();
+});
+test('unknown marker survives logout without retaining reflection, content or credentials', () => {
+  saveChildSession({ token: 'secret-token', child: { childId: id(1), familyId: id(2), name: '合成孩子' } });
+  const marker = beginReflectionWrite(scope, { logId: id(9), childReflection: '私密内容', token: 'secret-token' });
+  clearChildSession();
+  expect(readReflectionWrite(scope)).toEqual(marker);
+  expect(marker.raw).not.toContain('私密内容');
+  expect(marker.raw).not.toContain('secret-token');
+  expect(readReflectionWrite({ ...scope, actorId: id(3), childId: id(3) })).toBeNull();
+  expect(readReflectionWrite({ ...scope, familyId: id(4) })).toBeNull();
+});
+test('begin cannot overwrite an unresolved marker; clearing is exact-marker scoped', () => {
+  const marker = beginReflectionWrite(scope, {});
+  expect(() => beginReflectionWrite(scope, {})).toThrow();
+  expect(clearReflectionWrite(scope, { ...marker, raw: 'wrong' })).toBe(false);
+  expect(readReflectionWrite(scope)).toEqual(marker);
+  expect(clearReflectionWrite(scope, marker)).toBe(true);
+  expect(readReflectionWrite(scope)).toBeNull();
+});
+test('corrupt marker fails closed and can be explicitly reconciled without parsing private text', () => {
+  beginReflectionWrite(scope, {});
+  sessionStorage.setItem(sessionStorage.key(0), 'broken');
+  const marker = readReflectionWrite(scope);
+  expect(marker.kind).toBe('unknown');
+  expect(() => beginReflectionWrite(scope, {})).toThrow();
+  expect(clearReflectionWrite(scope, marker)).toBe(true);
+});
+test('unavailable persistence fails closed before a caller can send a write', () => {
+  const spy = jest.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });
+  try { expect(() => beginReflectionWrite(scope, {})).toThrow('quota'); } finally { spy.mockRestore(); }
+});
diff --git a/frontend/web/src/components/family/ReflectionPanel.js b/frontend/web/src/components/family/ReflectionPanel.js
new file mode 100644
index 00000000..8ecbf7a5
--- /dev/null
+++ b/frontend/web/src/components/family/ReflectionPanel.js
@@ -0,0 +1,181 @@
+import React, { useCallback, useEffect, useId, useMemo, useRef, useState } from 'react';
+import * as childApi from '../../services/childApi';
+import * as familyApi from '../../services/familyApi';
+import { captureSession, isSessionCurrent, subscribeSessionChanges } from '../../services/familySession';
+import { assertLearningScope, isLearningDenied, isLearningId, learningReadMessage } from '../../services/learningSources';
+import { beginReflectionWrite, clearReflectionWrite, readReflectionLogs, readReflectionWrite, reflectionWeek } from '../../services/reflection';
+
+const DIMENSIONS = [['academic', '智育'], ['moral', '德育'], ['physical', '体育'], ['artistic', '美育'], ['labor', '劳育']];
+const unknownText = '保存结果尚未确定，请重读全部记录并人工核对，不要重复提交。';
+
+const ReflectionEditor = ({ role, familyId, childId, grade, weekStart, session, isAllowed, deny }) => {
+  const reflectionInputId = useId();
+  const scope = useMemo(() => ({ role, actorId: session.actorId, familyId, childId }), [role, session, familyId, childId]);
+  const [rows, setRows] = useState([]);
+  const [editor, setEditor] = useState(null);
+  const [loading, setLoading] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [unknown, setUnknown] = useState(() => {
+    try { return readReflectionWrite(scope); } catch { return { storageError: true }; }
+  });
+  const [reconciled, setReconciled] = useState(false);
+  const [rowScope, setRowScope] = useState('week'), [listReady, setListReady] = useState(false);
+  const alive = useRef(true), readSequence = useRef(0), writing = useRef(false);
+  const controllers = useRef(new Set());
+  const current = useCallback(() => alive.current && isAllowed(), [isAllowed]);
+  const load = useCallback(async (all = false) => {
+    if (!current()) return;
+    const sequence = ++readSequence.current, controller = new AbortController();
+    controllers.current.add(controller);
+    setLoading(true); setError(''); setReconciled(false); setListReady(false);
+    const assertActive = () => {
+      if (!current() || sequence !== readSequence.current) throw Object.assign(new Error('stale'), { code: 'SESSION_CHANGED' });
+    };
+    try {
+      const list = role === 'student' ? childApi.listOwnGrowthLogs : familyApi.listGrowthLogs;
+      const result = await readReflectionLogs(query => list(query, controller.signal, session), scope,
+        all ? {} : reflectionWeek(weekStart), assertActive);
+      assertActive();
+      setRows(result); setReconciled(all); setRowScope(all ? 'all' : 'week'); setListReady(!all);
+    } catch (readError) {
+      // A same-scope denial wins even when another refresh superseded this request.
+      if (isAllowed() && isLearningDenied(readError)) { deny(); return; }
+      if (!current()) return;
+      if (sequence === readSequence.current && readError?.code !== 'SESSION_CHANGED') setError(learningReadMessage(readError));
+    } finally {
+      controllers.current.delete(controller);
+      if (current() && sequence === readSequence.current) setLoading(false);
+    }
+  }, [current, role, scope, session, weekStart, isAllowed, deny]);
+  useEffect(() => {
+    alive.current = true;
+    const pendingControllers = controllers.current;
+    load();
+    return () => { alive.current = false; pendingControllers.forEach(controller => controller.abort()); };
+  }, [load]);
+
+  const save = async event => {
+    event.preventDefault();
+    if (!current() || writing.current || unknown || !editor) return;
+    if (editor.childReflection.length > 500 || (!editor.logId && (!editor.content.trim() || !editor.childReflection.trim()))) {
+      setError('请填写记录内容和反思，反思不能超过 500 字。'); return;
+    }
+    let marker;
+    try {
+      reflectionWeek(editor.date);
+      marker = beginReflectionWrite(scope, editor.logId ? { logId: editor.logId } : {});
+    } catch {
+      setError('无法保存写入保护或存在未核对记录，请重新打开并核对。'); return;
+    }
+    writing.current = true; setBusy(true); setError(''); setMessage(''); setReconciled(false);
+    const controller = new AbortController(); controllers.current.add(controller);
+    try {
+      const create = role === 'student' ? childApi.createOwnGrowthLog : familyApi.createGrowthLog;
+      const patch = role === 'student' ? childApi.updateOwnGrowthLog : familyApi.updateGrowthLog;
+      const result = editor.logId
+        ? await patch(editor.logId, { childReflection: editor.childReflection }, controller.signal, session)
+        : await create({ childId, date: editor.date, dimension: editor.dimension, subject: editor.subject,
+          content: editor.content.trim(), childReflection: editor.childReflection.trim() }, controller.signal, session);
+      if (!current()) return;
+      const log = result?.log;
+      assertLearningScope(log, 'logId', editor.logId || log?.logId, familyId, childId);
+      if (!isLearningId(log.logId) || typeof log.childReflection !== 'string') throw new Error('Invalid saved record');
+      if (!clearReflectionWrite(scope, marker)) throw new Error('Write marker changed');
+      setUnknown(null); setEditor(null); setMessage('反思已保存。');
+      await load();
+    } catch (saveError) {
+      if (isAllowed() && isLearningDenied(saveError)) { deny(); return; }
+      if (!current()) return;
+      const status = saveError?.response?.status;
+      if ([400, 409, 422].includes(status)) {
+        try {
+          if (!clearReflectionWrite(scope, marker)) throw new Error('Write marker changed');
+          setError('保存被拒绝，请检查输入或重新读取记录。');
+        } catch { setUnknown(marker); }
+      } else setUnknown(marker);
+    } finally {
+      controllers.current.delete(controller);
+      if (current()) { writing.current = false; setBusy(false); }
+    }
+  };
+  const finishReconciliation = () => {
+    if (!current() || !reconciled || busy || !unknown || unknown.storageError) return;
+    try {
+      if (!clearReflectionWrite(scope, unknown)) throw new Error('Write marker changed');
+      setUnknown(null); setEditor(null); setReconciled(false); setRows([]); setRowScope('week'); setListReady(false);
+      setMessage('已结束上次编辑，请重新选择记录。');
+      load();
+    } catch { setError('无法解除写入保护，请重新打开并核对。'); }
+  };
+
+  const locked = busy || Boolean(unknown);
+  return <section className="family-panel" aria-label="成长反思">
+    <div className="family-page-heading"><h2>{role === 'student' ? '我的反思' : '孩子反思与家长代录'}</h2>
+      <button type="button" className="family-button" onClick={() => load()}>重新加载反思</button></div>
+    {loading && <p role="status">正在读取反思…</p>}
+    {error && <p role="alert" className="family-form-error">{error}</p>}
+    {message && <p role="status" className="family-success-message">{message}</p>}
+    {unknown && <div role="alert">
+      <p>{unknown.storageError ? '无法读取写入保护，暂不能保存。请恢复浏览器存储后重新打开。' : unknownText}</p>
+      {!unknown.storageError && <button type="button" className="family-button" disabled={loading || busy} onClick={() => load(true)}>重读全部记录并核对</button>}
+      {reconciled && !unknown.storageError && <button type="button" className="family-button" onClick={finishReconciliation}>已核对，结束上次编辑</button>}
+    </div>}
+    {rowScope === 'all' && <p>以下是该孩子的全部记录。没有找到记录也不能确定上次保存失败。</p>}
+    <ul className="family-list">{rows.map(log => <li key={log.logId}>
+      <div><strong>{log.content}</strong><p>{log.date}</p><p>{log.childReflection || '尚未填写反思'}</p>
+        {log.parentNote && <p>家长备注：{log.parentNote}</p>}</div>
+      <button type="button" className="family-button" aria-label={`修改反思：${log.content}`} disabled={locked || !listReady}
+        onClick={() => { setEditor({ ...log, childReflection: log.childReflection || '' }); setMessage(''); }}>修改反思</button>
+    </li>)}</ul>
+    {!loading && rows.length === 0 && <p>暂无成长记录。</p>}
+    <button type="button" className="family-button" disabled={locked || !listReady} onClick={() => {
+      setEditor({ date: weekStart, dimension: 'academic', subject: '数学', content: '', childReflection: '' }); setMessage('');
+    }}>新增反思</button>
+    {editor && <form className="family-feedback-form" onSubmit={save}>
+      {role === 'parent' && <p>本次由家长代录。</p>}
+      {!editor.logId && <>
+        <label>记录日期<input type="date" required value={editor.date} disabled={locked}
+          onChange={e => setEditor({ ...editor, date: e.target.value })} /></label>
+        <label>成长维度<select value={editor.dimension} disabled={locked} onChange={e => setEditor({ ...editor, dimension: e.target.value })}>
+          {DIMENSIONS.map(([value, label]) => <option key={value} value={value}>{label}</option>)}</select></label>
+        <label>学科<input value={editor.subject} maxLength={50} disabled={locked} onChange={e => setEditor({ ...editor, subject: e.target.value })} /></label>
+        <label>记录内容<textarea required maxLength={1000} value={editor.content} disabled={locked} onChange={e => setEditor({ ...editor, content: e.target.value })} /></label>
+      </>}
+      <label htmlFor={reflectionInputId}>{role === 'student' ? '我的反思' : '孩子反思'}</label>
+      <textarea id={reflectionInputId} maxLength={500} required={!editor.logId} disabled={locked}
+        placeholder={grade === 1 ? '今天学会了什么？写一句话就好。' : grade === 4 ? '哪里做得好，下一次想怎样改进？' : '今天的收获和下一步'}
+        value={editor.childReflection} onChange={e => setEditor({ ...editor, childReflection: e.target.value })} />
+      <button className="family-button primary" type="submit" disabled={locked}>保存反思</button>
+      <button className="family-button" type="button" onClick={() => setEditor(null)}>关闭反思编辑</button>
+    </form>}
+  </section>;
+};
+
