+import ast
+import copy
+import io
+import json
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+SOURCE=(Path(__file__).parent/'monitor.py').read_text()
+TREE=ast.parse(SOURCE)
+PREFIX=ast.Module(body=[n for n in TREE.body if isinstance(n,(ast.Import,ast.ImportFrom,ast.FunctionDef))],type_ignores=[])
+NS={}
+exec(compile(PREFIX,'monitor.py','exec'),NS)
+ID='a'*64
+ORIGINAL='b'*64
+LIVE='c'*64
+PROJECT='family-growth-isolated-t7-race-test'
+START=100000000000
+LISTED=110000000000
+UNTIL=120000000000
+
+def events(actions=('create','start','die','destroy')):
+    rows=[]
+    for index,action in enumerate(actions):
+        attrs={'lms.isolation.run':PROJECT,'com.docker.compose.project':PROJECT,
+               'com.docker.compose.service':'release-prepare','name':PROJECT+'-prepare-storage'}
+        if action=='die':attrs['exitCode']='0'
+        rows.append({'Type':'container','Action':action,'Actor':{'ID':ID,'Attributes':attrs},
+                     'timeNano':(START if action in ['create','start','commit'] else LISTED)+index+1})
+    return rows
+
+def observed(identifier=ID):
+    return {identifier:{'run':PROJECT,'timeNano':LISTED-1,'row':{
+        'nano':400000000,'quota':0,'period':0,'memory':256*1024**2,'swap':256*1024**2,'oom':False}}}
+
+class RaceTests(unittest.TestCase):
+    def setUp(self):
+        for name in ['deletion_proofs','missing_ids','fetch_deletion_proofs']:
+            self.assertTrue(callable(NS.get(name)),name+' is not implemented')
+
+    def proofs(self,value=None,missing=None,cache=None):
+        return NS['deletion_proofs'](events() if value is None else value,
+            [ID] if missing is None else missing,PROJECT,START,LISTED,UNTIL,observed() if cache is None else cache)
+
+    def missing(self,stderr=None,rows=None,requested=None,code=1):
+        result=SimpleNamespace(returncode=code,stderr=(stderr or ('error: no such object: '+ID+'\n')).encode())
+        return NS['missing_ids'](result,[ORIGINAL,ID] if requested is None else requested,
+            [{'id':ORIGINAL}] if rows is None else rows,{ORIGINAL:None},PROJECT)
+
+    def test_current_run_normal_deletion_is_proven(self):
+        proof=self.proofs()
+        self.assertEqual([p['id'] for p in proof],[ID])
+        self.assertEqual(proof[0]['actions'],['create','start','die','destroy'])
+
+    def test_unproven_builder_commit_cannot_replace_role_proof(self):
+        chain=events(('create','commit','destroy'))
+        for event in chain:
+            attrs=event['Actor']['Attributes']
+            for key in ['com.docker.compose.project','com.docker.compose.service','name']:del attrs[key]
+        with self.assertRaises(RuntimeError):self.proofs(chain)
+        with self.assertRaises(RuntimeError):self.proofs(events(('create','destroy')))
+
