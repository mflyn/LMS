+      { requestOptions: { ...p.requestOptions, maxInputTokens: 8192 } },
+      { messages: [{ role: 'system', content: 'changed' }, p.messages[1]] }]) {
+      expect(() => operation.buildRequest({ preview: { ...p, ...patch } })).toThrow();
