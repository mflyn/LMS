+    if field == "estimatedReservationMicros":
+        assert check_policy(body, trial(True), 1893456000000) == "PROFILE_UNAVAILABLE"
+    else:
+        with pytest.raises(ContractError):
+            parse_request(rfc8785.dumps(body))
