+    def test_lowercase_missing_object_records_bytes_and_still_stops(self):
+        message=('error: no such object: '+ID+'\n').encode()
+        row,_=self.failure(raw=message)
+        self.assertEqual(row['exit'],1)
+        self.assertEqual(row['stderrBytes'],len(message))
+        self.assertEqual(row['stderrSha256'],hashlib.sha256(message).hexdigest())
+        self.assertEqual(row['diagnostics'],[{'category':'MISSING_OBJECT','requestedId':ID}])
+
+    def test_lowercase_missing_container_partial_output_still_stops(self):
+        row,_=self.failure('error: no such container: '+ID+'\n',stdout='{"id":"partial"}\n')
+        self.assertGreater(row['stdoutBytes'],0)
+        self.assertEqual(row['diagnostics'],[{'category':'MISSING_CONTAINER','requestedId':ID}])
+
+    def test_lowercase_unrequested_identifier_is_not_exposed(self):
